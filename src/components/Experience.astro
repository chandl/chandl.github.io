---
import { experience } from '../data/resume';

// Split text into plain / metric pieces so numbers like "1M+", ">$1B", "30k", "200%" pop.
const METRIC = /((?:[>~])?\$?\d+(?:\.\d+)?(?:[kKMB]\+?|\+|%))/;
// split() with a capture group puts the matches at odd indices.
const pieces = (text: string) => text.split(METRIC).map((t, i) => ({ t, metric: i % 2 === 1 }));
---

<section id="experience" class="section">
  <div class="wrap">
    <header class="section-head reveal">
      <span class="section-label"><b>02</b> / experience</span>
      <h2 class="section-title">Distributed systems, at scale.</h2>
      <p class="section-sub">
        From healthcare integrations to tier-0 cloud infrastructure — usually as the engineer who starts the thing.
      </p>
    </header>

    <ol class="timeline">
      {
        experience.map((job) => (
          <li class="job reveal">
            <div class="when mono">
              <span>{job.start}</span>
              <span class="dash">→</span>
              <span class={job.end === 'Present' ? 'present' : undefined}>{job.end}</span>
            </div>
            <div class="what">
              <h3 class="position">{job.position}</h3>
              <p class="company mono">
                @{job.company}
                {job.location && <span class="loc"> · {job.location}</span>}
              </p>
              <p class="summary">
                {pieces(job.summary).map((p) => (p.metric ? <strong class="metric">{p.t}</strong> : p.t))}
              </p>
              {job.highlights && (
                <ul class="highlights">
                  {job.highlights.map((h) => (
                    <li>{pieces(h).map((p) => (p.metric ? <strong class="metric">{p.t}</strong> : p.t))}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }

  /* rail + progress line that draws as you scroll */
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    top: 10px;
    bottom: 10px;
    left: calc(170px + 23px);
    width: 1px;
    background: var(--line-strong);
  }

  .timeline::after {
    background: linear-gradient(var(--accent), color-mix(in srgb, var(--accent) 30%, transparent));
    transform-origin: top;
    transform: scaleY(1);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline::after {
        animation: draw linear both;
        animation-timeline: view();
        animation-range: entry 30% exit 30%;
      }
    }
  }

  @keyframes draw {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  .job {
    display: grid;
    grid-template-columns: 170px 1fr;
    gap: 48px;
    padding: 20px 0;
  }

  .when {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
    align-content: flex-start;
    padding-top: 4px;
    font-size: 12.5px;
    color: var(--muted);
    white-space: nowrap;
  }

  .dash {
    color: var(--line-strong);
  }

  .present {
    color: var(--accent);
  }

  .what {
    position: relative;
  }

  /* node on the rail */
  .what::before {
    content: '';
    position: absolute;
    left: -29px;
    top: 9px;
    width: 11px;
    height: 11px;
    border-radius: 99px;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }

  .position {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .company {
    margin-top: 4px;
    font-size: 13px;
    color: var(--accent);
  }

  .loc {
    color: var(--muted);
  }

  .summary {
    margin-top: 10px;
    color: var(--fg-dim);
    max-width: 70ch;
  }

  .highlights {
    margin-top: 12px;
    display: grid;
    gap: 8px;
    max-width: 70ch;
  }

  .highlights li {
    position: relative;
    padding-left: 22px;
    color: var(--fg-dim);
    font-size: 15px;
  }

  .highlights li::before {
    content: '▹';
    position: absolute;
    left: 2px;
    color: var(--accent);
  }

  .metric {
    font-weight: 600;
    color: var(--fg);
    background: var(--accent-soft);
    padding: 0 4px;
    border-radius: 4px;
    white-space: nowrap;
  }

  @media (max-width: 720px) {
    .timeline::before,
    .timeline::after {
      left: 5px;
    }
    .job {
      grid-template-columns: 1fr;
      gap: 6px;
      padding-left: 32px;
    }
    .when {
      justify-content: flex-start;
    }
    .what::before {
      left: -32px;
      top: -22px;
    }
  }

  @media print {
    .timeline::before,
    .timeline::after,
    .what::before {
      display: none;
    }
    .job {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 6px 0;
      break-inside: avoid;
    }
    .when {
      justify-content: flex-start;
      order: 2;
    }
    .position {
      font-size: 12pt;
    }
    .metric {
      background: none;
      padding: 0;
    }
  }
</style>
