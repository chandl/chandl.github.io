---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { profile } from '../data/resume';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);

const host = (url: string) => new URL(url).host;
---

<section id="projects" class="section">
  <div class="wrap">
    <header class="section-head reveal">
      <span class="section-label"><b>01</b> / projects</span>
      <h2 class="section-title">Things I build after hours.</h2>
      <p class="section-sub">Small, sharp tools — self-hostable, open source, and running in production.</p>
    </header>

    <ul class="grid">
      {
        projects.map(({ data }, i) => (
          <li class="card reveal" style={data.accent ? `--card-accent:${data.accent}` : undefined} data-card>
            <div class="card-top mono">
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <span class={`status status-${data.status}`}>{data.status}</span>
            </div>

            <h3 class="card-title">
              <a href={data.url ?? data.repo} target="_blank" rel="noopener" class="no-url stretched">
                {data.title}
              </a>
            </h3>
            {data.url && <p class="card-host mono">{host(data.url)}</p>}
            <p class="card-tagline">{data.tagline}</p>

            <ul class="stack mono" aria-label="Tech stack">
              {data.stack.map((s) => (
                <li>{s}</li>
              ))}
            </ul>

            <div class="card-links">
              {data.url && (
                <a href={data.url} target="_blank" rel="noopener" class="card-link">
                  Visit <Icon name="arrow" size={14} />
                </a>
              )}
              <a href={data.repo} target="_blank" rel="noopener" class="card-link">
                <Icon name="github" size={14} /> Source
              </a>
            </div>
          </li>
        ))
      }

      <li class="card card-more reveal no-print" data-card>
        <div class="card-top mono">
          <span class="idx">{String(projects.length + 1).padStart(2, '0')}</span>
          <span class="status">wip</span>
        </div>
        <h3 class="card-title">
          <a href={profile.links.github} target="_blank" rel="noopener" class="stretched">More in the lab</a>
        </h3>
        <p class="card-tagline">Experiments, forks, and half-finished ideas live on GitHub.</p>
        <p class="more-cmd mono" aria-hidden="true">
          <span class="dollar">$</span> gh repo list {profile.handle}<span class="cursor"></span>
        </p>
      </li>
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 330px), 1fr));
    gap: 16px;
    perspective: 1200px;
  }

  .card {
    --card-accent: var(--accent);
    --mx: 50%;
    --my: 50%;
    --rx: 0deg;
    --ry: 0deg;
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 330px;
    padding: 24px;
    border-radius: var(--radius);
    background: var(--bg-elev);
    border: 1px solid var(--line);
    isolation: isolate;
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      transform 0.5s var(--ease-out),
      border-color 0.3s,
      box-shadow 0.3s;
  }

  /* cursor spotlight */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      420px circle at var(--mx) var(--my),
      color-mix(in srgb, var(--card-accent) 16%, transparent),
      transparent 45%
    );
    opacity: 0;
    transition: opacity 0.3s;
  }

  /* glowing border that follows the cursor */
  .card::after {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: radial-gradient(
      260px circle at var(--mx) var(--my),
      var(--card-accent),
      transparent 60%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }

  .card:hover {
    box-shadow: var(--shadow);
  }

  .card:hover::before,
  .card:hover::after,
  .card:focus-within::after {
    opacity: 1;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: var(--muted);
  }

  .idx {
    color: var(--card-accent);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
  }

  .status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 99px;
    background: var(--muted);
  }

  .status-live::before {
    background: #3ddc97;
    box-shadow: 0 0 8px #3ddc97;
  }

  .status-wip::before {
    background: #ffb547;
  }

  .card-title {
    margin-top: 48px;
    font-size: 28px;
    font-weight: 650;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .stretched::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
  }

  .card-host {
    margin-top: 6px;
    font-size: 12.5px;
    color: var(--card-accent);
  }

  .card-tagline {
    margin-top: 14px;
    color: var(--fg-dim);
    font-size: 15px;
  }

  .stack {
    margin-top: auto;
    padding-top: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 11.5px;
  }

  .stack li {
    padding: 3px 9px;
    border-radius: 6px;
    background: var(--bg-elev-2);
    border: 1px solid var(--line);
    color: var(--fg-dim);
  }

  .card-links {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 8px;
    margin-top: 18px;
    padding-top: 18px;
    border-top: 1px dashed var(--line-strong);
  }

  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 500;
    color: var(--fg-dim);
    border: 1px solid var(--line-strong);
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }

  .card-link:hover {
    color: var(--fg);
    border-color: var(--card-accent);
    background: color-mix(in srgb, var(--card-accent) 10%, transparent);
  }

  .card-link :global(svg) {
    transition: transform 0.25s var(--ease-out);
  }

  .card-link:hover :global(svg) {
    transform: translate(1px, -1px);
  }

  /* full-width banner so the grid stays tidy for any number of projects */
  .card-more {
    grid-column: 1 / -1;
    min-height: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    column-gap: 24px;
    padding-block: 20px;
    background: transparent;
    border-style: dashed;
    border-color: var(--line-strong);
  }

  .card-more .card-top {
    display: contents;
  }

  .card-more .status {
    display: none;
  }

  .card-more .card-title {
    margin: 0;
    font-size: 20px;
  }

  .card-more .card-tagline {
    grid-column: 2;
    grid-row: 2;
    margin: 0;
    font-size: 14px;
  }

  .more-cmd {
    grid-column: 3;
    grid-row: 1 / 3;
    font-size: 13px;
    color: var(--fg-dim);
  }

  @media (max-width: 720px) {
    .card-more {
      grid-template-columns: auto 1fr;
    }
    .more-cmd {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: 14px;
    }
  }

  .dollar {
    color: var(--accent);
  }

  .cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    margin-left: 4px;
    vertical-align: -2px;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @media print {
    .grid {
      display: block;
      perspective: none;
    }
    .card {
      min-height: 0;
      padding: 6px 0;
      border: 0;
      transform: none;
      background: none;
      break-inside: avoid;
    }
    .card-top,
    .card-links,
    .stack {
      display: none;
    }
    .card-title {
      margin: 0;
      font-size: 12pt;
    }
    .card-tagline {
      margin-top: 2px;
    }
  }
</style>

<script>
  // Spotlight + subtle 3D tilt that tracks the pointer.
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (fine) {
    document.querySelectorAll<HTMLElement>('[data-card]').forEach((card) => {
      card.addEventListener('pointermove', (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width;
        const y = (e.clientY - r.top) / r.height;
        card.style.setProperty('--mx', `${x * 100}%`);
        card.style.setProperty('--my', `${y * 100}%`);
        if (!still) {
          card.style.setProperty('--rx', `${(0.5 - y) * 6}deg`);
          card.style.setProperty('--ry', `${(x - 0.5) * 8}deg`);
        }
      });
      card.addEventListener('pointerleave', () => {
        card.style.setProperty('--rx', '0deg');
        card.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>
